{
 "version": 1,
 "units": "game units (1 unit = 0.1 m in Blender); screen is 360 units wide",
 "board": {
  "ox": 26,
  "oy": 92,
  "cols": 11,
  "rows": 9,
  "cellW": 28,
  "cellH": 18,
  "note": "formation origin at the start; it marches +-14 sideways and steps down 14, so draw bricks relative to the live origin"
 },
 "plate": {
  "file": "plate.png",
  "jpg": "plate.jpg",
  "px": [
   720,
   1640
  ],
  "ppu": 2,
  "screenRect": [
   0,
   -40,
   360,
   820
  ],
  "convention": "pixel (px, py) <-> screen (x, y): px = 2*x, py = 2*(y + 40); draw plate at screen (0, -40) with size 360 x 820 units",
  "stretchNote": "everything below y = 500 is generic wall / deck; stretch or tile that band for screens taller than 780"
 },
 "spriteConvention": "sprites are 3 px/unit; draw each centred on its anchor at the footprint centre, at size drawSize (units) = px / 3. Cell sprites (bricks, bots, masks): footprint 28 x 18 + a 4-unit transparent margin, so a cell (c, r) is drawn at x = ox + c*28 - 4, y = oy + r*18 - 4, w = 36, h = 26. Mothership: drawSize 108 x 80 centred on the boss position; its hit ellipse (radii 44 x 18) is centred hullCenter units from the sprite centre. bolt 16 x 24, bomb 20 x 24, centred.",
 "tintJitter": 0.04,
 "tintNote": "multiply glazed candy brick RGB by 1 + tintJitter*(2*hash(c,r)-1) for per-brick variation (composite.png does this)",
 "botTint": "bot_white_<expr> has a near-white body (#f4f6fb). To tint to any colour T: draw bot_white, then draw it again into an offscreen buffer, multiply by T, keep only bot_mask_<expr> (destination-in) and draw that over. pink / yellow / blue are real renders for rows 0, 2, 5.",
 "botColors": {
  "white": "#f4f6fb",
  "pink": "#ff5d8f",
  "yellow": "#ffd23f",
